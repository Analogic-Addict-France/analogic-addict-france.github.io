<script>
    let pendingUrl = null;

    function openModal(url, name) {
        if (!url || url === '#') {
            alert("Lien d'achat non disponible pour le moment.");
            return;
        }
        pendingUrl = url;
        document.getElementById('redirectModal').classList.add('active');
    }

    function closeModal() {
        document.getElementById('redirectModal').classList.remove('active');
        pendingUrl = null;
    }

    document.getElementById('confirmRedirect').addEventListener('click', function() {
        if (pendingUrl) window.open(pendingUrl, '_blank');
        closeModal();
    });
    document.getElementById('cancelRedirect').addEventListener('click', closeModal);
    document.getElementById('redirectModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });

    // ── Voir plus / Voir moins ──
    const voirPlusState = { meubles: false, supports: false, goodies: false };

    function toggleVoirPlus(cat) {
        const listId = 'list-' + cat;
        const btnId  = 'btn-voir-plus-' + cat;
        const hidden = document.querySelectorAll('#' + listId + ' .article-hidden');
        const btn    = document.getElementById(btnId);

        voirPlusState[cat] = !voirPlusState[cat];

        hidden.forEach(el => {
            el.style.display = voirPlusState[cat] ? 'flex' : 'none';
        });
        btn.textContent = voirPlusState[cat]
            ? '▴ Voir moins'
            : '▾ Voir plus de recommandations';
    }

    // ── Image auto Amazon si src vide ──
    document.querySelectorAll('.article-img').forEach(img => {
        if (!img.getAttribute('src') || img.getAttribute('src') === '') {
            const asin = img.getAttribute('data-asin');
            if (asin && asin !== 'TON_ASIN_KALLAX' && !asin.startsWith('TON_')) {
                img.src = `https://ws-eu.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=${asin}&Format=_SL110_&ID=AsinImage&MarketPlace=FR&ServiceVersion=20070822&WS=1&tag=TON_TAG`;
            }
        }
    });
</script>
